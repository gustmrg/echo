# Copy to `.env` in the project root (docker compose loads it automatically).
# Development uses SeaweedFS S3 and RabbitMQ with local-only example credentials.

# API UID: only the API mounts SQLite.
ECHO_APP_UID=1654

# Production S3 storage
S3_BUCKET=echo
AWS_REGION=us-east-1

# Prefer an IAM role or workload identity in production. These are available
# for deployments that need static or temporary AWS credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Transcription worker
TRANSCRIPTION_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TRANSCRIPTION_MODEL=openai/gpt-4o-mini-transcribe

# Required only when TRANSCRIPTION_PROVIDER=openai
OPENAI_API_KEY=

# Broker credentials: replace BOTH password and URL before production.
RABBITMQ_USER=echo
RABBITMQ_PASSWORD=echo-dev-only
RABBITMQ_URL=amqp://echo:echo-dev-only@rabbitmq:5672
RABBITMQ_JOB_QUEUE=echo.jobs
RABBITMQ_RESULT_QUEUE=echo.results

# Local speech server with an OpenAI-compatible /v1/audio/transcriptions endpoint.
# Required model when TRANSCRIPTION_PROVIDER=local (download it in the server first).
LOCAL_TRANSCRIPTION_BASE_URL=http://host.docker.internal:8000/v1
LOCAL_TRANSCRIPTION_MODEL=Systran/faster-whisper-small
LOCAL_TRANSCRIPTION_API_KEY=

# Defaults to TRANSCRIPTION_PROVIDER. May independently be openrouter, openai, or local.
# Local refinement requires REFINEMENT_MODEL and a separate chat-capable server.
REFINEMENT_PROVIDER=
REFINEMENT_API_KEY=
REFINEMENT_MODEL=
REFINEMENT_BASE_URL=
JOB_TIMEOUT_MS=120000

# Embedded whisper.cpp (TRANSCRIPTION_PROVIDER=whisper-cpp).
# Use docker-compose.whisper.yml to mount downloaded models read-only.
WHISPER_MODELS_DIR=./models
WHISPER_MODEL_PATH=/models/ggml-small.bin
WHISPER_BINARY_PATH=whisper-cli
FFMPEG_PATH=ffmpeg
WHISPER_LANGUAGE=auto
WHISPER_THREADS=4
WHISPER_USE_GPU=false
# Refinement defaults to local with whisper-cpp: set REFINEMENT_MODEL or
# explicitly choose REFINEMENT_PROVIDER=openrouter/openai with its credentials.
